# This file is the source for ~/.tmux.conf (see ../termedi/bin/setup). Edit here, then run bin/setup -f to install.
set -g status-right "#{?window_zoomed_flag,🔍 ,}"
set -g escape-time 0
set -g mouse on
# Needed so apps (e.g. vim/nvim autoread) see terminal focus in/out events
set -g focus-events on
set -g mode-keys vi
set -g status-style bg=$TMUX_COLOR

# Window status
set -g window-status-current-format "#W"
set -g window-status-current-style "bold,underscore"
set -g window-status-format "#W"
set -g window-status-style "fg=#aaaaaa"
set -g window-status-separator " "

# Vim-style pane navigation
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

# Make new split and window preserve the current path
bind '"' split-window -c "#{pane_current_path}"
bind % split-window -h -c "#{pane_current_path}"
bind c new-window -c "#{pane_current_path}"

# Vi copy mode
bind -T copy-mode-vi v send -X begin-selection
bind -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "termux-clipboard-set"

# Clipboard
set -s set-clipboard on
set -g allow-passthrough on
